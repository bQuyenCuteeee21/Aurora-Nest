@startuml
left to right direction
skinparam packageStyle rectangle
actor "Quản trị viên" as Admin
actor "Nhân viên lễ tân" as Receptionist
actor "Khách hàng" as Customer
actor "Cổng thanh toán" as Gateway
rectangle "HTT19 - Quản lý khách sạn và Homestay" {
 usecase "Đăng nhập" as Login
 usecase "Quản lý phòng" as Rooms
 usecase "Quản lý khách hàng" as Guests
 usecase "Đặt phòng" as Booking
 usecase "Check-in" as CheckIn
 usecase "Check-out" as CheckOut
 usecase "Quản lý dịch vụ" as Services
 usecase "Thanh toán" as Payment
 usecase "Báo cáo doanh thu" as Reports
}
Admin --> Login
Admin --> Rooms
Admin --> Guests
Admin --> Services
Admin --> Reports
Receptionist --> Login
Receptionist --> Booking
Receptionist --> CheckIn
Receptionist --> CheckOut
Receptionist --> Payment
Customer --> Booking
Customer --> Payment
Gateway --> Payment
CheckOut ..> Payment : <<include>>
@enduml
      
